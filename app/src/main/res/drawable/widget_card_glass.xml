<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Ambient drop shadow: offset down-right, no top/left inset. -->
    <item android:left="6dp" android:top="7dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/wgt_card_radius" />
            <solid android:color="@color/wgt_shadow" />
        </shape>
    </item>

    <!-- 2. Specular highlight: offset up-left, produces the neumorphic bevel. -->
    <item android:left="0dp" android:top="0dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/wgt_card_radius" />
            <solid android:color="@color/wgt_specular" />
        </shape>
    </item>

    <!-- 3. Translucent body + glassy rim. -->
    <item android:left="@dimen/wgt_card_inset" android:top="@dimen/wgt_card_inset"
          android:right="@dimen/wgt_card_inset" android:bottom="@dimen/wgt_card_inset">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/wgt_card_radius" />
            <solid android:color="@color/wgt_surface" />
            <stroke android:width="1dp" android:color="@color/wgt_rim" />
        </shape>
    </item>

    <!-- 4. Wallpaper hue veil: tints the card toward the extracted accent. -->
    <item android:left="@dimen/wgt_card_inset" android:top="@dimen/wgt_card_inset"
          android:right="@dimen/wgt_card_inset" android:bottom="@dimen/wgt_card_inset">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/wgt_card_radius" />
            <solid android:color="@color/wgt_hue_veil" />
        </shape>
    </item>

</layer-list>
